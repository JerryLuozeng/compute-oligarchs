{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Compute Oligarchs",
  "version": "0.1.0",
  "identifier": "com.compute-oligarchs.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "算力寡头 · Compute Oligarchs",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}
